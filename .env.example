# ──────────────────────────────────────
# Supabase
# ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ──────────────────────────────────────
# Auth & Access Control
# ──────────────────────────────────────
OWNER_EMAIL=you@example.com

# ──────────────────────────────────────
# Site
# ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aniket.one

# ──────────────────────────────────────
# Email (optional – contact form notifications)
# If not set, emails are logged to console instead.
# ──────────────────────────────────────
RESEND_API_KEY=

# ──────────────────────────────────────
# Rate Limiting (optional – uses Upstash Redis)
# If not set, rate limiting is disabled with a warning.
# ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
